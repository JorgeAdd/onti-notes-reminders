# Copy to .env (never commit .env).
PORT=3000
# https://<project-ref>.supabase.co — public value.
SUPABASE_URL=
# Supabase session pooler connection string (Project → Connect → Session pooler).
# SECRET: contains the database password.
DATABASE_URL=
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
