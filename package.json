{
  "name": "onti-notes-reminders",
  "private": true,
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "prepare": "node .husky/install.mjs",
    "engram:export": "sh scripts/engram-sync.sh export",
    "engram:import": "sh scripts/engram-sync.sh import"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "typescript": "^7.0.2"
  }
}
