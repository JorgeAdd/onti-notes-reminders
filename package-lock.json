    "": {
      "name": "onti-notes-reminders",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "devDependencies": {
        "husky": "^9.1.7"
      },
      "engines": {
        "node": ">=22"
      }
    },
    "apps/api": {
      "name": "@onti/api",
