{
  "name": "onti-notes-reminders",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "onti-notes-reminders",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "apps/api": {
      "name": "@onti/api",
      "version": "0.0.0"
    },
    "apps/web": {
      "name": "@onti/web",
      "version": "0.0.0"
    },
    "node_modules/@onti/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@onti/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/@onti/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/shared": {
      "name": "@onti/shared",
      "version": "0.0.0"
    }
  }
}
